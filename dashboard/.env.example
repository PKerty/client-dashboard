# Postgres (Neon). En Vercel la setea el marketplace.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Para desarrollar sin Postgres: DATABASE_URL=pglite:./.pglite
# Clave para entrar al dashboard.
DASHBOARD_PASSWORD=cambiame
# Secreto para firmar la cookie de sesión: openssl rand -hex 32
AUTH_SECRET=cambiame
# Token que usa la automatización para hablar con /api: openssl rand -hex 32
INGEST_TOKEN=cambiame
# URL pública del dashboard, la usa automation/scripts/api.sh
DASHBOARD_URL=http://localhost:3000
